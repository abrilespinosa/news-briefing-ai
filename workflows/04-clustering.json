    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO normalized_articles (link, title, content, category, source_name, published_date, language, embedding)\nVALUES ($1, $2, $3, $4, $5, $6, $7, $8)\nON CONFLICT (link) DO NOTHING;",
        "options": {
          "queryReplacement": "=={{ [$json.link, $json.title, $json.content, $json.category, $json.source_name, $json.published_date, $json.language, JSON.stringify($json.embedding)] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1344,
        -48
      ],
      "id": "ce9738b8-2f4a-4f58-80bc-cc849fa04507",
      "name": "Insert Normalized Articles",
      "credentials": {
        "postgres": {
          "id": "z9SLVuZpj5X17xUz",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const articles = $('Get Articles for Clustering Window').all().map(item => item.json);\nconst edges = $input.all().map(item => item.json);\n\nconst idToIndex = new Map();\narticles.forEach((a, i) => idToIndex.set(a.id, i));\n\nconst n = articles.length;\nconst parent = Array.from({ length: n }, (_, i) => i);\n\nfunction find(i) {\n  if (parent[i] !== i) {\n    parent[i] = find(parent[i]);\n  }\n  return parent[i];\n}\n\nfunction union(i, j) {\n  const rootI = find(i);\n  const rootJ = find(j);\n  if (rootI !== rootJ) {\n    parent[rootJ] = rootI;\n  }\n}\n\n// Las aristas ya vienen filtradas por umbral (0.83) calculadas en Postgres con pgvector\nfor (const edge of edges) {\n  const i = idToIndex.get(edge.id_a);\n  const j = idToIndex.get(edge.id_b);\n  if (i !== undefined && j !== undefined) {\n    union(i, j);\n  }\n}\n\n// Agrupar artículos por su raíz de cluster\nconst clustersMap = {};\nfor (let i = 0; i < n; i++) {\n  const root = find(i);\n  if (!clustersMap[root]) {\n    clustersMap[root] = [];\n  }\n  clustersMap[root].push(articles[i]);\n}\n\n// Convertir a array de clusters, con metadatos útiles\nconst clusters = Object.values(clustersMap).map((articleGroup, index) => ({\n  cluster_id: index,\n  article_count: articleGroup.length,\n  source_count: new Set(articleGroup.map(a => a.source_name)).size,\n  sources: [...new Set(articleGroup.map(a => a.source_name))],\n  articles: articleGroup.map(a => ({\n    title: a.title,\n    link: a.link,\n    source_name: a.source_name,\n    category: a.category,\n    content: a.content\n  }))\n}));\n\nreturn clusters.map(cluster => ({ json: cluster }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        48
      ],
      "id": "219b0b4f-2f7f-40c6-a6f7-4bc2ea30c581",
      "name": "Cluster Articles by Similarity"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH window_articles AS (\n  SELECT id, embedding\n  FROM normalized_articles\n  WHERE processed_at >= NOW() - INTERVAL '24 hours'\n)\nSELECT a.id AS id_a, b.id AS id_b\nFROM window_articles a\nJOIN window_articles b ON a.id < b.id\nWHERE 1 - (a.embedding <=> b.embedding) >= 0.83;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
