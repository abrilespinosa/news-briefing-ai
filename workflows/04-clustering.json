      ],
      "id": "df1c246c-9ce5-4c40-a35d-b5d52da75230",
      "name": "Generate Embeddings"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst embeddings = response.embeddings;\n\nconst originalItems = $('Prepare Embedding Input').first().json.items;\n\nif (embeddings.length !== originalItems.length) {\n  throw new Error(\n    `Desajuste: ${embeddings.length} embeddings recibidos vs ${originalItems.length} artículos originales`\n  );\n}\n\nreturn originalItems.map((item, index) => ({\n  json: {\n    ...item,\n    embedding: embeddings[index]\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
