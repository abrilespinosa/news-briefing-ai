    {
      "parameters": {
        "jsCode": "const items = $input.all().filter(item => item.json.title);\n\nconst texts = items.map(item => {\n  const title = item.json.title || '';\n  const content = item.json.content || '';\n\n  const sentences = content\n    .split(/(?<=[.!?])\\s+/)\n    .filter(s => s.trim().length > 0)\n    .slice(0, 3);\n\n  const excerpt = sentences.join(' ');\n\n  return `${title}. ${excerpt}`.trim();\n});\n\nreturn [{\n  json: {\n    texts,\n    items: items.map(item => item.json)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        48
      ],
      "id": "01a907f8-3052-477f-ae38-bb828341afbb",
      "name": "Prepare Embedding Input"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/embed",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"bge-m3\",\n  \"input\": {{ JSON.stringify($json.texts) }}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
