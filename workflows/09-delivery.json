      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "n09-trigger",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Día natural UTC, igual que el corte con el que 08 lo construyó: si aquí se\n-- usara otro criterio, se podría entregar un briefing distinto del que se generó.\n--\n-- El destinatario viaja en la misma consulta, como subconsulta: no depende de la\n-- fila y así el workflow no gana un nodo solo para leer un escalar. Sale de\n-- app_config y no de una variable de entorno porque n8n 2.x deniega $env en las\n-- expresiones por defecto, y levantar ese bloqueo es global (ver db/schema.sql).\n-- Si la clave faltase, chat_id llega NULL y Telegram falla de forma ruidosa, que\n-- es lo correcto: un briefing que no se entrega no debe pasar por entregado.\nSELECT b.briefing_date,\n       b.cluster_count,\n       b.divergence_count,\n       b.payload,\n       b.content_html,\n       (SELECT value FROM app_config WHERE key = 'telegram_chat_id') AS chat_id\nFROM briefings b\nWHERE b.briefing_date = (now() AT TIME ZONE 'UTC')::date;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "id": "n09-get",
      "name": "Get Today's Briefing",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "z9SLVuZpj5X17xUz",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "has09",
              "leftValue": "={{ $json.cluster_count }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        0
      ],
      "id": "n09-if",
      "name": "Anything to Deliver?"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        672,
        160
      ],
      "id": "n09-nada",
      "name": "Nothing to Deliver"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Compone lo que se manda a Telegram. Deliberadamente escueto: el mensaje solo\n// anuncia el briefing, no lo resume. Todo el contenido está en el adjunto, y\n// duplicarlo aquí obligaría a leer dos veces lo mismo.\nconst MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',\n               'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];\n\nconst fila = $input.first().json;\n\n// briefing_date puede llegar como Date o como cadena según el driver.\nconst iso = String(fila.briefing_date instanceof Date\n  ? fila.briefing_date.toISOString().slice(0, 10)\n  : fila.briefing_date).slice(0, 10);\nconst [y, m, d] = iso.split('-').map(Number);\n\n// El payload guarda cuántos medios distintos aparecen realmente en el briefing,\n// que no es lo mismo que cuántas fuentes hay configuradas: un día cualquiera\n// algunas no aportan ningún cluster multi-fuente.\nconst payload = typeof fila.payload === 'string' ? JSON.parse(fila.payload) : fila.payload;\nconst medios = payload?.medios ?? 0;\n\n// No hace falta escapar: en la cabecera solo entran una fecha y dos números\n// calculados aquí. Si alguna vez se añadiera texto de una noticia, habría que\n// escaparlo antes, porque el mensaje se manda con parse_mode HTML.\nconst header = `<b>Briefing · ${d} de ${MESES[m - 1]} de ${y}</b>\\n`\n  + `${fila.cluster_count} acontecimientos · ${medios} medios`;\n\nreturn [{\n  json: {\n    header,\n    despedida: 'Ten un buen día.',\n    filename: `briefing-${iso}.html`,\n    content_html: fila.content_html,\n    chat_id: fila.chat_id\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "n09-build",
      "name": "Build Telegram Payload"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Build Telegram Payload').first().json.chat_id }}",
        "text": "={{ $json.header }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        896,
        0
      ],
      "id": "n09-header",
      "name": "Send Header",
      "credentials": {
        "telegramApi": {
          "id": "Aw5GE6JvXKSNL4Kk",
          "name": "Telegram Meollo"
        }
      },
      "webhookId": "acbcdc20-b32c-4cde-9ff7-fa072fb82b31"
    },
    {
      "parameters": {
        "jsCode": "// El nodo de Telegram sustituye el item por la respuesta de su API, así que el\n// HTML se perdería aquí. Se recupera del nodo que lo compuso, igual que hacen\n// \"Return New Articles\" en 03 y \"Return Categorized Clusters\" en 07.\nreturn $('Build Telegram Payload').all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
