# PostgreSQL
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=n8n

# Timezone (ajusta a tu región, ej: Europe/Madrid)
TIMEZONE=Europe/Madrid

# n8n (Settings → API en el editor, para automatizar el propio n8n vía API)
N8N_API_KEY=

# Groq (console.groq.com) — motor LLM de la fase 05, nivel gratuito
GROQ_API_KEY=
