# PostgreSQL
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=n8n

# Timezone (ajusta a tu región, ej: Europe/Madrid)
TIMEZONE=Europe/Madrid

# n8n (Settings → API en el editor, para automatizar el propio n8n vía API)
N8N_API_KEY=

# Groq (console.groq.com) — motor LLM de la fase 05, nivel gratuito
GROQ_API_KEY=
# Telegram (bot creado con @BotFather) — canal de entrega de la fase 09.
# El token va en una credencial de n8n, no en un nodo. El destinatario no se pasa
# por entorno: n8n 2.x deniega $env en las expresiones por defecto, así que vive
# en la tabla app_config de Postgres (ver README, instalación de la fase 09).
TELEGRAM_BOT_TOKEN=
